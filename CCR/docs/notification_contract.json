{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCR Power Automate notification",
  "type": "object",
  "required": ["proceso", "periodo", "tipo_evento", "mensaje", "destinatarios", "canal", "fecha_programada"],
  "properties": {
    "proceso": {"type": "string"},
    "periodo": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
    "tipo_evento": {"type": "string"},
    "mensaje": {"type": "string"},
    "destinatarios": {"type": "array", "items": {"type": "string", "format": "email"}},
    "canal": {"type": "string", "enum": ["Teams", "Correo", "Teams, Correo"]},
    "fecha_programada": {"type": "string", "format": "date-time"},
    "enlace_app": {"type": "string"}
  }
}
